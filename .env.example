# .env.example - Kopyala ve .env yap, kendi bilgilerini gir
# Asla git'e commit etme!

TELEGRAM_BOT_TOKEN=1234567890:AAH_example_token_here
TELEGRAM_CHAT_ID=123456789
BOT_PROFILE=Dengeli

# Sunucu saat dilimi: Telegram günlük/saatlik sayaçları ve log damgaları BIST
# saatine göre olsun (Render'da UTC varsayılanı günlük kotayı 03:00'te sıfırlıyordu).
TZ=Europe/Istanbul

# 18:45 erteleme özetinde gösterilecek en fazla aday (Telegram 4096 karakter
# sınırı). Kalan adaylar kaybolmaz: metinde "12/21 gösteriliyor" ve
# "… 9 aday daha (tam liste: /formasyonlar)" satırı çıkar.
DEFERRED_ALERT_DIGEST_LIMIT=12

# Yahoo Finance tarama temposu (varsayılanlar: BIST 50, seri ve sınırlı pacing)
SCAN_REQUEST_BATCH_SIZE=10
SCAN_REQUEST_DELAY_MIN_SEC=0.9
SCAN_REQUEST_DELAY_MAX_SEC=1.5
SCAN_BATCH_PAUSE_MIN_SEC=10
SCAN_BATCH_PAUSE_MAX_SEC=15
SCAN_RETRY_BACKOFF_MIN_SEC=30
SCAN_RETRY_BACKOFF_MAX_SEC=60

# Alarm kareleri (grafik). Varsayılan `yok`: hiçbir kare üretilmez, gönderim
# öncekiyle birebir aynıdır. `alarm` → alarm METNİ gittikten sonra hissenin mum
# karesi eklenir (1 olay = 1 metin + kareler; görseller mesaj kotasını YEMEZ).
# Kare kartla aynı veriyi çizer: bant/temas, OB+FVG kutuları, BOS/CHoCH + kritik
# seviyesi, hacim şeridi. Üretim 0,5-0,7 s/kare; tarama turu sonunda gönderilir.
TELEGRAM_GRAFIK=yok
# Alarm başına en fazla kare (1-4): birincil zaman dilimi her zaman ilk karedir.
TELEGRAM_GRAFIK_ADET=4
# FAZ 2 akıllı kadraj: formasyon YOKKEN gösterilecek mum sayısı.
# Varsayılan TF matrisi: 1s 80 · 2s 74 · 4s 68 · 1g 62 (sağ boşluk bunun DIŞINDA).
# Formasyon varsa kadraj formasyona odaklanır: formasyon + 10 mum sol tampon,
# 35-85 mum aralığına kırpılır. Bu anahtar yalnız üst sınırı ezer.
GRAFIK_MUM_MAKS=80
# Kareye çizilen onaylı+geçerli BOS/CHoCH sayısı (fazlası atlanır, kare kalabalık olmasın).
GRAFIK_OLAY_MAKS=6
# Sağ boşluk: son mumun sağında bırakılan boş alan, EKSEN GENİŞLİĞİNİN yüzdesi.
# Varsayılan %15; kabul penceresi %10-20 (otomatik kural bu aralığa kırpılır).
# Fiyat etiketleri, seviye çizgileri, 🎯 hedef kutusu ve aktif BOS hedefi bu alana
# çizilir; OB/FVG kutuları ve bant çizgileri buraya kadar uzar. 0 = kapalı.
GRAFIK_SAG_BOSLUK_ORANI=0.15
# Sabit mum sayısı isterseniz (eski yol; verilirse üstteki yüzde anahtarını ezer):
# GRAFIK_SAG_BOSLUK_MUM=15
# En eski oran anahtarı (aynı anlam, %5,3) yalnız tanımlıysa kullanılır:
# GRAFIK_SAG_BOSLUK=5.3
# FAZ 1: alt hacim paneli kaldırıldı (dikey alan mumlara kalır; RVOL bilgisi mum
# altındaki YÖNLÜ ⚡ rozetinde). 1 = eski hacim kulvarını geri getir.
GRAFIK_HACIM_PANELI=0
# RVOL rozeti eşikleri: üstü "hacim patlaması" (⚡↑ yeşil), altı "hacim kuruması"
# (⚡↓ kırmızı). Varsayılan 2,0 / 0,5; kuruma rozeti gürültülü gelirse 0,35 yapın.
# GRAFIK_RVOL_ROZET_ESIK=2.0
# GRAFIK_RVOL_ROZET_ESIK_DUSUK=0.5
# Kuruma rozeti kare başına en fazla bu kadar (varsayılan 2; 0 = kuruma rozeti kapalı).
# GRAFIK_RVOL_ROZET_DUSUS_MAKS=2
# Toplam rozet tavanı (iki yön; varsayılan 6 → kare başına 3-6 rozet).
# Her yönün EN YENİ uygun mumu her zaman rozet alır (yeni sinyal gecikmez).
# GRAFIK_RVOL_ROZET_MAKS=6
# FAZ 1: kare içi lejant/dipnot bloğu kaldırıldı (bilgi kart altı dipnotuna gider).
# 1 = eski görünüm (kare altında lejant + gri/kırmızı satırlar).
GRAFIK_LEJANT_KARE=0
# Güven şeridi her zaman görünür; üstteki anahtar yalnız eski teknik lejant içindir.
# Odak: yakın tamamlanmamış bölgeler. Bağlam: geçmiş/uzak kayıtlar (kotalı).
GRAFIK_GORUNUM=odak
# Görünüm eşiği; işlem/başarı kuralı değildir. Mesafe bölge SINIRINA göredir.
GRAFIK_ODAK_MESAFE_ATR=3.0
# 1 = 780x1100, daha büyük yazılı mobil çıktı (varsayılan masaüstü).
GRAFIK_MOBIL=0
# Kare içi yazı ölçeği (virgül/sağ nokta ikisi de kabul: 1.25 veya 1,25).
# Boş = yerleşik varsayılan. Kullanıcı arayüzünden gelen değer bunu ezer.
# GRAFIK_YAZI=1.25

# Supabase kalıcı cache (Render Environment'ta gerçek değerleri secret olarak girin)
# SQL'i Supabase SQL Editor'da çalıştırmadan bu değişkenleri etkinleştirmeyin.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public HTTP uçları: IP başına dakikalık istek limiti (0 = kapalı).
HEALTH_RATE_LIMIT_PER_MIN=60
# /test anahtarını ?k= sorgusunda kabul et (1) veya yalnız X-Test-Key başlığı (0).
TELEGRAM_TEST_KEY_QUERY=1

# Yazma amplikasyonu (B5): heartbeat Supabase yazım aralıkları (saniye)
HEARTBEAT_MIN_ARALIK_SN=60
HEARTBEAT_UZAK_ARALIK_SN=300

# Çoklu örnek kimliği (B10). Boş bırakılırsa "hostname:pid" kullanılır.
# Aynı Supabase anahtarlarını paylaşan iki kopya çalıştırıyorsan her birine
# farklı bir ad ver; bot 5 dakikada bir diğer canlı örnekleri kontrol edip
# Telegram'a SOFT uyarı atar (veri bozulmaz, yalnız çift mesaj riski bildirilir).
BOT_INSTANCE_ID=

# Eski pickle cache'i yeniden yazmak için 1 yapın (varsayılan: kapalı, JSON birincil)
PICKLE_CACHE=0

# Opsiyonel: /health ucundan Telegram'a tek test mesaji gondermek icin anahtar.
# Bos birakilirsa /test ucu 404 doner ve Telegram'a hicbir istek gitmez.
# Render'da tanimlarsan: https://<servis>.onrender.com/test?k=<deger>
TELEGRAM_TEST_KEY=

# --- Telegram komutlari: yoklama (varsayilan) mi, webhook mu? ---
# BOS BIRAKILIRSA bot getUpdates uzun yoklamasini kullanir (yerel/systemd icin dogru olan).
# NOT: Render Free servisi 15 dk inbound trafik almazsa uyur ve uyuyan servis DM
# komutunu goremez (Telegram mesaji bir HTTP istegi degildir). Rastgele bir deger
# yazilirsa komutlar webhook ile gelir; Telegram'in POST'u gercek bir istek oldugu
# icin uyuyan servisi uyandirir -> DM komutlari icin en dayanikli mod.
#   adres RENDER_EXTERNAL_URL'den uretilir -> https://<servis>.onrender.com/webhook
#   Telegram'a secret_token olarak da bildirilir; her istekte X-Telegram-Bot-Api-Secret-Token
#   basligi dogrulanir. Webhook acikken getUpdates CALISMAZ (ikisi ayni anda olmaz).
# Rastgele secret: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TELEGRAM_WEBHOOK_SECRET=

# Opsiyonel: webhook adresini elle ver. Bos birakirsan RENDER_EXTERNAL_URL kullanilir.
# Kabul edilen bicimler:
#   https://<servis>.onrender.com/webhook            (onerilen: sirsiz yol + secret_token basligi)
#   https://<servis>.onrender.com                    (sonuna /webhook eklenir)
#   https://<servis>.onrender.com/webhook/<secret>   (eski bicim; calisir ama sir
#                                                     adres/loglarda gorunur, uyari loglanir)
TELEGRAM_WEBHOOK_URL=

# Render bu degiskeni Web Service'lerde OTOMATIK enjekte eder (https://<servis>.onrender.com).
# Yerelde webhook denemek istersen elle doldurabilirsin; bos kalirsa yoklama kullanilir.
RENDER_EXTERNAL_URL=

# --- PUBLIC HEDEF: KANAL ya da GRUP (DM'den BAĞIMSIZ yayın) ---
# Önerilen: KANAL (@bisthisseveri gibi herkese açık kullanıcı adı ya da -100… kimliği).
# Kurulum: KANAL_ACILIS_PAKETI.md · kontrol: python kanal_acilis.py --durum
# DM kapalı olsa bile (TELEGRAM_CHAT_ID boş) bu hedef çalışır.
# ÖNEMLİ: bot bu hedefte ADMIN olmalı — mesaj gönderme (zorunlu), mesajları
# sabitle + bilgiyi değiştir (açıklama/sabit mesajı bot yazsın istersen).
TELEGRAM_GROUP_ID=
# Geriye dönük: yalnız kanal kullanıyorsan eski değişken. Grup ID'si varsa o kazanır.
TELEGRAM_CHANNEL_ID=

# --- PUBLIC GRUP KOMUTLARI (2026-10-28) ---
# Grup/supergroup'ta komut çalıştırma. Eskiden public hedef komut KABUL ETMEZDI
# ("orası yalnız yayın alır"); artık grup YÖNETİCİLERİ okuma komutlarını
# çalıştırabilir. Üç kilit: sohbet listede + komut beyaz listede + gönderen
# getChatMember ile administrator/creator. Yönetici olmayan üyenin komutu
# SESSİZCE yok sayılır; yönetici API'si yanıt vermezse yetki VERİLMEZ.
# DM (TELEGRAM_CHAT_ID) davranışı değişmez: orada her komut çalışır.
PUBLIC_COMMANDS_ENABLED=1
# Boş bırakılırsa TELEGRAM_GROUP_ID / TELEGRAM_CHANNEL_ID kullanılır.
# Virgülle birden fazla sohbet: -100…,@grup_adi
#
# ⚠️ GRUP olmalı, KANAL DEĞİL. Kanalda komut İMKÂNSIZDIR: üyeler kanala mesaj
# yazamaz, admin gönderileri `channel_post` olarak gelir ve gönderen kişi (`from`)
# yoktur → yöneticilik doğrulanamaz. `TELEGRAM_GROUP_ID` bu projede kanalı
# gösterebilir (02.10.2026 kararı KANAL); o yüzden komutlar için ayrı bir grup
# açıp kimliğini BURAYA yazın. Kanal yayını TELEGRAM_GROUP_ID ile sürer.
# Teşhis: DM'den /teshis · ya da `python public_komut_teshis.py`
PUBLIC_COMMAND_CHATS=
# Public'te varsayılan olarak KAPALI komutları tek tek aç (virgülle):
# tara, grafik, evet, hayir  →  örn: PUBLIC_COMMAND_EXTRA=tara
# /grafik ve /g açıldığında kareler + sonuç metni KOMUTUN GELDİĞİ gruba gider
# (2026-10-28); örnek: PUBLIC_COMMAND_EXTRA=grafik,g
# DİKKAT: /tara tam evren taramasıdır (dakikalarca sürer), grupta istek yarışı
# yaratabilir. /evet,/hayir gece önerisi KARARINI kayda geçirir.
PUBLIC_COMMAND_EXTRA=
# getChatMember sonucu kaç saniye önbelleklensin (her komutta API çağrısı
# Telegram hız limitine takılmasın). 0 = önbellek yok.
PUBLIC_COMMAND_ADMIN_CACHE_SN=300

# Özet saatleri (İstanbul); V1: kod içinde varsayılan 18:45
SUMMARY_HOURS=18:45
DEFERRED_ALERT_DIGEST_TIME=18:45
# İstanbul saati; gün sonu tam 48×4 analiz ve özel Telegram raporu
POST_CLOSE_ANALYSIS_TIME=20:00
# Seans dışında fetch başarısızsa cache verisine en çok kaç gün izin verilsin
OFFSESSION_CACHE_MAX_AGE_DAYS=14
# Güvenlik: legacy pickle cache unpickle edilmez (kod çalıştırabilir). Yalnızca
# kaynağı tamamen güvenilir eski cache dosyaları için bilinçli olarak 1 yapın.
ALLOW_TRUSTED_PICKLE_CACHE=0
# Public kalite kapısı TF bazlıdır ve DM alarm eşikleriyle aynıdır
# (1h 80 · 2h 78 · 4h 75 · 1d 70). Aşağıdaki değer ek TABAN'dır; 0 = kapalı.
PUBLIC_MIN_QUALITY=0
# TF bazında geçersiz kılma: "1h:82,2h:80,4h:78,1d:72" (boş = DM eşikleri)
PUBLIC_MIN_QUALITY_TF=

# --- Devamlılık puanı muslukları (2026-10-25; bkz. devamlilik.py) ---
# Puan kartta GÖSTERİLMEZ; yalnız log/sıralama/gölge kayıt + bu musluklar için.
# DEVLAMLILIK_AKTIF=0 -> 25 Eyl kart metni birebir geri gelir (rollback yolu).
DEVLAMLILIK_AKTIF=1
# DM musluğu: >0 verilirse yalnız puanı en az bu olan olaylar DM'e gider.
# 0 = kapalı (davranış değişmez). Kayıt/public akışı bu musluktan etkilenmez.
DM_MIN_DEVLAMLILIK=0
# Public (grup/bülten) musluğu: >0 verilirse yalnız puanı en az bu olan olaylar
# kuyruğa girer. 0 = kapalı. DM musluğundan AYRIdır.
PUBLIC_MIN_DEVLAMLILIK=0
# Gruba giden olaylar. ❌ BASARISIZ_KIRILIM bilinçli olarak yok: gruba tek tek
# değil, 18:45 özetinde "❌ N kırılım başarısız" satırı olarak gider.
# Kart/DM biçimi ve kapıları (repo varsayılanı = kart; satır bütçesi 283 px).
# TELEGRAM_ALERT_STYLE=klasik  -> 25 Eyl öncesi uzun biçim (A/B karşılaştırması için)
TELEGRAM_ALERT_STYLE=kart
TELEGRAM_SATIR_PX=283
TELEGRAM_ALERT_MAX_KARAKTER=1100
# Aynı hisse+TF+state için bağlam (yapı/bölge/hacim) birebir aynıysa kopya blok
# tekrar basılmaz; kartın bağlam kısmı tek satıra iner. 0 = kapalı.
TELEGRAM_DM_DEGISIM_KAPISI=1
# Kart süzgeci: kartın görünmeyenini söyler (eşik, bant yaşı, MTF, retest,
# katılım yorumu, karşı delil). 0 = 25 Eyl tam kartı birebir geri gelir.
TELEGRAM_KART_SUZGEC=1
# Beklenti (tahmin) hükmü: "◇ beklenti: devam" + sayaç satırı. VARSAYILAN
# KAPALI (2026-10-22): canlı akışta bir hafta izlenmeden açılmayacak.
# 1 = aç. Yön kanıtı yoksa satır basılmaz; hüküm tek kelimedir.
TELEGRAM_KART_TAHMIN=0
# Kanala "geçersizleşti" yalnızca önceki teyitli mesaj gerçekten o kanala
# gitmişse gider. 0 = her geçersizleşme kanala da gider.
TELEGRAM_KANAL_GECERSIZ_KAPISI=1

# Gruba giden olaylar. FORMASYON_TAMAMLANDI bilinçli olarak LİSTEDE YOK: biçimleyici o
# state için hiç mesaj üretmiyor (yalnız teyit / retest / geçersizleşme push edilir).
PUBLIC_STATES=KIRILIM_TEYITLI,RETEST_BASARILI,KIRILIM_GECERSIZLESTI
PUBLIC_SIKISMA_MIN_CONTRACTION=0.80
# Public bütçe + tempo (DM kapılarından AYRI; Telegram grup başına 20 mesaj/dk sınırı koyar)
PUBLIC_MAX_MESAJ_SAAT=6
PUBLIC_MAX_MESAJ_GUN=25
PUBLIC_MIN_ARALIK_SN=1.2

# --- Batch 7 (C1/C3/C4): pazar, evren, veri dizinleri ---
# BIST dışında bir pazar izlemek isterseniz Yahoo eki (varsayılan: .IS)
MARKET_SUFFIX=.IS

# Virgülle ayrılmış hisse listesi; BOŞ bırakılırsa BIST 50 kullanılır.
# Örnek: STOCK_UNIVERSE=THYAO,GARAN,AKBNK
STOCK_UNIVERSE=

# Makro semboller (BRENT vb., BIST dışı seans) alarm üretsin mi? Varsayılan
# KAPALI: kapanış kuralı BIST seansına göre, gün sonu barları hizalanamaz.
# 1 = aç. Veri/grafik/bağlam her durumda çalışır; yalnız push kapalıdır.
MAKRO_ALARM=0

# Kalıcı veri dizini (Batch 7 / C4: repo dışı varsayılan).
# BOŞ bırakılırsa sırasıyla: RENDER ortamı → /tmp/formation-bot-data →
# /var/lib/formation-bot/data → ~/.formation-bot/data → ./bot_data
# (ilk yazılabilir aday seçilir; /var/lib ve ~ altındaki dizinler gerekirse oluşturulur)
DATA_DIR=

# Yalnız OKUMA yedeği: DATA_DIR'de dosya yoksa buradaki örnek/seed veri okunur.
SEED_DATA_DIR=./bot_data

# Log dizini; yazılamıyorsa ./logs'a düşer
LOG_DIR=/var/log/bist-bot
# Yerel (fallback) log dizini: LOG_DIR yazılamazsa (yetki/disk) buraya düşülür.
# Boş bırakılırsa ./logs kullanılır.
LOCAL_LOG_DIR=

# Supabase'de aynı tabloyu paylaşan ikinci bir örnek varsa anahtar çakışmasın
# diye kayıtlar bu ön ekle yazılır (varsayılan: formation-bot:).
# "off" yazarsanız eski (öneksiz) davranışa döner.
SUPABASE_STORE_PREFIX=formation-bot:

# Opsiyonel
LOG_LEVEL=INFO

# Geçersizleşme: tolerans ötesinde art arda kapanan mum sayısı (her TF kendi mumuyla).
INVALIDATION_CONFIRM_BARS=3

# Aynı hisse/formasyon/yön/olayın TF kopyalarını ilk paketle birleştirme penceresi.
MTF_ALERT_MERGE_HOURS=4

# --- Geliştirme / CI (üretimde dokunmayın) ---
# 1 = ana tarama/veri/bildirim döngüleri KAPALI başlar; yalnız /health yüzeyi
# ayakta kalır (CI duman testi ve deploy doğrulaması için).
# BOT_HEALTH_SMOKE_ONLY=1
# Bazı teşhis scriptleri (scripts/diagnostics/) canlı Yahoo'ya çıkar; kaza ile
# çalışmasınlar diye bu bayrak açık değilse kendiliğinden dururlar.
# FORMATION_BOT_ALLOW_LIVE_YAHOO_RESEARCH=1
