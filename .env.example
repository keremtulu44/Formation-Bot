# .env.example - Kopyala ve .env yap, kendi bilgilerini gir
# Asla git'e commit etme!

TELEGRAM_BOT_TOKEN=1234567890:AAH_example_token_here
TELEGRAM_CHAT_ID=123456789
BOT_PROFILE=Dengeli

# Yahoo Finance tarama temposu (varsayılanlar: BIST 50, seri ve sınırlı pacing)
SCAN_REQUEST_BATCH_SIZE=10
SCAN_REQUEST_DELAY_MIN_SEC=0.9
SCAN_REQUEST_DELAY_MAX_SEC=1.5
SCAN_BATCH_PAUSE_MIN_SEC=10
SCAN_BATCH_PAUSE_MAX_SEC=15
SCAN_RETRY_BACKOFF_MIN_SEC=30
SCAN_RETRY_BACKOFF_MAX_SEC=60

# Supabase kalıcı cache (Render Environment'ta gerçek değerleri secret olarak girin)
# SQL'i Supabase SQL Editor'da çalıştırmadan bu değişkenleri etkinleştirmeyin.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opsiyonel: /health ucundan Telegram'a tek test mesaji gondermek icin anahtar.
# Bos birakilirsa /test ucu 404 doner ve Telegram'a hicbir istek gitmez.
# Render'da tanimlarsan: https://<servis>.onrender.com/test?k=<deger>
TELEGRAM_TEST_KEY=

# --- Telegram komutlari: yoklama (varsayilan) mi, webhook mu? ---
# BOS BIRAKILIRSA bot getUpdates uzun yoklamasini kullanir (yerel/systemd icin dogru olan).
# Rastgele bir deger yazilirsa komutlar webhook ile gelir (Render Web Service icin onerilir):
#   adres RENDER_EXTERNAL_URL'den uretilir -> https://<servis>.onrender.com/webhook/<secret>
#   Telegram'a secret_token olarak da bildirilir; her istekte X-Telegram-Bot-Api-Secret-Token
#   basligi dogrulanir. Webhook acikken getUpdates CALISMAZ (ikisi ayni anda olmaz).
# Rastgele secret: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TELEGRAM_WEBHOOK_SECRET=

# Opsiyonel: webhook adresini elle ver. Bos birakirsan RENDER_EXTERNAL_URL kullanilir.
# Kabul edilen bicimler:
#   https://<servis>.onrender.com/webhook/<secret>   (tam adres, aynen kullanilir)
#   https://<servis>.onrender.com/webhook            (sonuna /<secret> eklenir)
#   https://<servis>.onrender.com                    (sonuna /webhook/<secret> eklenir)
TELEGRAM_WEBHOOK_URL=

# Render bu degiskeni Web Service'lerde OTOMATIK enjekte eder (https://<servis>.onrender.com).
# Yerelde webhook denemek istersen elle doldurabilirsin; bos kalirsa yoklama kullanilir.
RENDER_EXTERNAL_URL=

# Public kanal (10k kişi için DM yerine kanal kullan)
# Kanal ID'si -100 ile başlar, örn: -1001234567890
# Botu kanala admin olarak ekle, yoksa 403 alırsın
TELEGRAM_CHANNEL_ID=

# Özet saatleri (İstanbul); kapanış özeti son otomatik taramadan sonra gelir
SUMMARY_HOURS=09:55,18:45
DEFERRED_ALERT_DIGEST_TIME=18:45
# İstanbul saati; gün sonu tam 48×4 analiz ve özel Telegram raporu
POST_CLOSE_ANALYSIS_TIME=20:00
# Seans dışında fetch başarısızsa cache verisine en çok kaç gün izin verilsin
OFFSESSION_CACHE_MAX_AGE_DAYS=14
PUBLIC_MIN_QUALITY=80
PUBLIC_STATES=FORMASYON_TAMAMLANDI,RETEST_BASARILI
PUBLIC_SIKISMA_MIN_CONTRACTION=0.80

# Opsiyonel
LOG_LEVEL=INFO
DATA_DIR=./bot_data
