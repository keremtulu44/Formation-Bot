import numpy as np
import pandas as pd

from patterns import (
    find_best_triangle_candidate,
    find_pivots,
    calculate_atr,
    f_line_price,
)


def create_random_walk(seed, n_bars=250, start_price=100.0):
    rng = np.random.default_rng(seed)

    returns = rng.normal(0, 1.0, n_bars)
    close = start_price + np.cumsum(returns)
    close = np.maximum(close, 1.0)

    high = close + np.abs(rng.normal(0, 0.5, n_bars))
    low = close - np.abs(rng.normal(0, 0.5, n_bars))

    return pd.DataFrame({
        "close": close,
        "high": high,
        "low": low,
    })


def independent_pivot_stats(df, candidate):
    high_pivots, low_pivots = find_pivots(df, 5)

    selected_high = {candidate.hb1, candidate.hb2}
    selected_low = {candidate.lb1, candidate.lb2}

    independent_high = [
        p for p in high_pivots
        if candidate.start_bar <= p["bar"] <= candidate.end_bar
        and p["bar"] not in selected_high
    ]

    independent_low = [
        p for p in low_pivots
        if candidate.start_bar <= p["bar"] <= candidate.end_bar
        and p["bar"] not in selected_low
    ]

    atr = calculate_atr(df, 14)
    current_atr = float(atr.iloc[-1])

    high_distances = []
    low_distances = []

    for p in independent_high:
        expected = f_line_price(
            candidate.hb1,
            candidate.hp1,
            candidate.hb2,
            candidate.hp2,
            p["bar"]
        )
        high_distances.append(
            abs(p["price"] - expected) / current_atr
        )

    for p in independent_low:
        expected = f_line_price(
            candidate.lb1,
            candidate.lp1,
            candidate.lb2,
            candidate.lp2,
            p["bar"]
        )
        low_distances.append(
            abs(p["price"] - expected) / current_atr
        )

    all_distances = high_distances + low_distances

    return (
        len(independent_high),
        len(independent_low),
        min(all_distances) if all_distances else None,
        max(all_distances) if all_distances else None,
        np.mean(all_distances) if all_distances else None,
    )


def current_break_stats(df, candidate):
    atr = calculate_atr(df, 14)

    close_violations = 0
    wick_violations = 0
    max_violation = 0.0

    for bar in range(candidate.end_bar + 1, len(df)):
        atr_value = atr.iloc[bar]

        if pd.isna(atr_value) or atr_value <= 0:
            atr_value = 1.0

        close_buf = atr_value * 0.06
        wick_buf = atr_value * 0.15

        upper = f_line_price(
            candidate.hb1,
            candidate.hp1,
            candidate.hb2,
            candidate.hp2,
            bar
        )

        lower = f_line_price(
            candidate.lb1,
            candidate.lp1,
            candidate.lb2,
            candidate.lp2,
            bar
        )

        close = float(df["close"].iloc[bar])
        high = float(df["high"].iloc[bar])
        low = float(df["low"].iloc[bar])

        upper_close = close > upper + close_buf
        lower_close = close < lower - close_buf

        upper_wick = (
            not upper_close
            and high > upper + wick_buf
        )

        lower_wick = (
            not lower_close
            and low < lower - wick_buf
        )

        if upper_close or lower_close:
            close_violations += 1

        if upper_wick or lower_wick:
            wick_violations += 1

        if upper_close:
            excess = (close - upper - close_buf) / atr_value
            max_violation = max(max_violation, excess)

        if lower_close:
            excess = (lower - close - close_buf) / atr_value
            max_violation = max(max_violation, excess)

        if upper_wick:
            excess = (high - upper - wick_buf) / atr_value
            max_violation = max(max_violation, excess)

        if lower_wick:
            excess = (lower - low - wick_buf) / atr_value
            max_violation = max(max_violation, excess)

    return close_violations, wick_violations, max_violation


