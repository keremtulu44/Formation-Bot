TOTAL = 50

found = 0
high_quality = 0
broken_after_end = 0
independent_bad = 0

qualities = []

for seed in range(TOTAL):
    df = create_random_walk(seed)

    candidate, _ = find_best_triangle_candidate(
        df,
        profile="Dengeli",
        verbose=False
    )

    if candidate is None or not candidate.valid:
        continue

    found += 1
    qualities.append(candidate.raw_quality)

    high, low, min_dist, max_dist, avg_dist = independent_pivot_stats(
        df,
        candidate
    )

    close_v, wick_v, max_v = current_break_stats(
        df,
        candidate
    )

    if candidate.raw_quality >= 80:
        high_quality += 1

    if close_v > 0 or wick_v > 0:
        broken_after_end += 1

    # Bağımsız pivotlardan herhangi biri 2 ATR'den fazla uzaktaysa
    # adayın çizgilerinin bağımsız pivotlarla zayıf doğrulandığını sayıyoruz.
    if max_dist is not None and max_dist > 2.0:
        independent_bad += 1

    print(
        f"seed={seed:2d} "
        f"Q={candidate.raw_quality:5.1f} "
        f"type={candidate.pattern_type:<18} "
        f"indHigh={high} "
        f"indLow={low} "
        f"indMaxATR={max_dist if max_dist is not None else float('nan'):6.2f} "
        f"postClose={close_v} "
        f"postWick={wick_v}"
    )

print()
